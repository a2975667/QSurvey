#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

should_check=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_ref:-}" ]]; then
    continue
  fi

  # Skip deletions.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    base_sha="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [[ -n "${base_sha:-}" ]]; then
      diff_base="$base_sha"
    else
      diff_base="$(git hash-object -t tree /dev/null)"
    fi
  else
    diff_base="$remote_sha"
  fi

  if git diff --name-only "$diff_base" "$local_sha" -- \
    client/package.json \
    client/package-lock.json \
    server/package.json \
    server/package-lock.json | grep -q .; then
    should_check=1
    break
  fi
done

if [[ "$should_check" -eq 0 ]]; then
  exit 0
fi

if [[ ! -d client/node_modules || ! -d server/node_modules ]]; then
  cat <<'EOF' >&2
pre-push: dependency notices check requires installed dependencies.
Run `npm ci --ignore-scripts --prefix client` and `npm ci --ignore-scripts --prefix server`,
then retry the push.
EOF
  exit 1
fi

scripts/generate-third-party-notices.sh

if ! git diff --quiet -- THIRD_PARTY_NOTICES.txt || \
   ! git diff --cached --quiet -- THIRD_PARTY_NOTICES.txt; then
  cat <<'EOF' >&2
pre-push: THIRD_PARTY_NOTICES.txt was updated by the hook.
Review the file, stage it, and commit it before pushing.
EOF
  exit 1
fi
