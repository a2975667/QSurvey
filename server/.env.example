# Copy this file to .env.development for local dev, and .env.production for prod.
# Never commit real secrets.

# MongoDB
MONGO_URI=mongodb://localhost:27017/qv_db

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENTID=your-google-oauth-client-id
GOOGLE_SECRET=your-google-oauth-client-secret

# App secrets
JWT_SECRET=change-me-in-production
# Deprecated transitional fallback. Keep aligned with JWT_SECRET only during migration.
# SECRET=change-me-in-production

# OAuth redirect (backend route handling Google callback)
# Dev: http://localhost:6060/api/v1/redirect
# Prod: https://your-domain.example/api/v1/redirect
REDIRECT_URL=http://localhost:6060/api/v1/redirect

# Frontend origin to redirect users after login success
# Dev: http://localhost:3000
# Prod: https://your-domain.example
FRONTEND_URL=http://localhost:3000

# Comma-separated list of browser origins allowed to call the API.
# Values must be exact origins: scheme + host + optional port, no path.
# Dev: http://localhost:3000
# Prod: https://your-domain.example
ALLOWED_ORIGINS=http://localhost:3000

# Optional
# PORT=6060
# NODE_ENV=development

# Debug and API docs toggles
# Defaults:
# - unset outside production: enabled for local development
# - unset with NODE_ENV=production: disabled
# Set true/1/yes/on to enable, or false/0/no/off to disable.
# ENABLE_DEBUG_LOGS=false
# ENABLE_SWAGGER=false

# API/DB abuse rate limits
# In-process, per-instance limits. IP-derived bucket keys are HMAC-hashed and
# kept only in memory for the active rate-limit window.
# Set RATE_LIMIT_TRUST_PROXY=1 for Cloud Run or another exactly-one-hop trusted
# proxy deployment. Leave unset for direct local/runtime deployments.
# RATE_LIMIT_TRUST_PROXY=1
# RATE_LIMIT_KEY_SALT=change-me-or-use-existing-app-secret
# Public survey limits are intentionally generous for market surveys and
# classrooms/labs where many respondents may share one campus/NAT IP.
# Auth/OAuth routes: /api/v1/google-login and /api/v1/redirect, keyed by IP.
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_AUTH_WINDOW_MS=300000
# Protected write/export routes: protected non-GET traffic plus export GETs, keyed
# by JWT user_id, then user_email, then IP fallback.
# RATE_LIMIT_PROTECTED_WRITE_MAX=300
# RATE_LIMIT_PROTECTED_WRITE_WINDOW_MS=900000
# Public survey reads/results: public survey fetch and response/result GET routes,
# keyed by IP.
# RATE_LIMIT_PUBLIC_READ_MAX=1500
# RATE_LIMIT_PUBLIC_READ_WINDOW_MS=900000
# Public survey submit/update/complete: non-GET /api/v1/survey/responses routes,
# keyed by surveyId + IP hash when surveyId is present, plus a higher IP-wide cap
# to prevent rotating fake survey IDs from bypassing DB abuse limits.
# RATE_LIMIT_PUBLIC_SUBMIT_MAX=5000
# RATE_LIMIT_PUBLIC_SUBMIT_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_SUBMIT_IP_MAX=20000
# RATE_LIMIT_PUBLIC_SUBMIT_IP_WINDOW_MS=900000
